{
  // nathancurtis.me on Cloudflare: static files from _site (built by the deploy workflow),
  // plus a Worker that only answers /sky.
  "name": "nathancurtis-me",
  "main": "worker/site.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/sky", "/music/*"]
  },
  "workers_dev": true,
  "observability": { "enabled": false },
  // www is redirected to the bare domain by a rule on the zone, before it reaches the Worker.
  "routes": [
    { "pattern": "nathancurtis.me", "custom_domain": true },
    { "pattern": "www.nathancurtis.me", "custom_domain": true }
  ]
}
